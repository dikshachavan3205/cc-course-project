# ChronoNet environment variables actually read by the codebase.
# None are required — every value has a code default (shared/constants.py or
# an inline fallback). Copy to .env and override only what you need.

# app/ — workload identity + simulation
CHRONONET_RUN_ID=run-local-dev
CHRONONET_VM_ID=vm-local-dev
CHRONONET_TOTAL_STEPS=100
CHRONONET_STEP_DELAY=0.1
CHRONONET_CHECKPOINT_INTERVAL=60

# monitoring/imds_watcher.py
CHRONONET_POLL_INTERVAL=5
CHRONONET_SIMULATE_INTERRUPTION=false

# orchestration/recovery_flow.py + launch_instance.py (real-EC2 launch only)
CHRONONET_AMI=
CHRONONET_SUBNET_ID=
CHRONONET_KEY_NAME=
CHRONONET_SECURITY_GROUP_IDS=
CHRONONET_ALLOW_REAL_EC2=false
CHRONONET_DISABLE_ALERTS=false

# data_backend/aws/sns_client.py
CHRONONET_SNS_TOPIC_ARN=

# data_backend/main.py (comma-separated allowed origins; "*" = any)
CHRONONET_CORS_ORIGINS=*

# data_backend/smoke_test.py
CHRONONET_API_URL=http://127.0.0.1:8001